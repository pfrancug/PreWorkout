# Firebase Emulator configuration for E2E tests
# These values are used by the Vite dev server when running E2E tests.
# The project "demo-preworkout" is a special emulator-only project that
# doesn't need real Firebase credentials.

VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_APP_ID=1:000000000000:web:fake
VITE_FIREBASE_AUTH_DOMAIN=demo-preworkout.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-preworkout-default-rtdb
VITE_FIREBASE_MEASUREMENT_ID=G-FAKE
VITE_FIREBASE_PROJECT_ID=demo-preworkout
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_STORAGE_BUCKET=demo-preworkout.appspot.com

# Emulator flags — the app should connect to emulators when these are set
VITE_USE_EMULATORS=true
