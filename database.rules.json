{
  "rules": {
    "users": {
      "$userId": {
        "settings": {
          ".read": "auth.uid == $userId",
          ".write": "auth.uid == $userId",
          ".validate": "newData.hasChildren(['name', 'age', 'height', 'sex']) && newData.child('name').isString() && newData.child('age').isString() && newData.child('height').isString() && newData.child('sex').isString() && (!newData.hasChild('avatarUrl') || newData.child('avatarUrl').isString())"
        },
        "preferences": {
          ".read": "auth.uid == $userId",
          ".write": "auth.uid == $userId",
          ".validate": "newData.hasChildren(['sidebarOpen', 'chatPanelOpen']) && newData.child('sidebarOpen').isBoolean() && newData.child('chatPanelOpen').isBoolean()"
        },
        "messages": {
          ".read": "auth.uid == $userId",
          ".write": "auth.uid == $userId"
        },
        "data": {
          ".read": "auth.uid == $userId",
          ".write": "auth.uid == $userId"
        },
        "limits": {
          ".read": "auth.uid == $userId",
          ".write": "auth.uid == $userId",
          ".validate": "newData.hasChildren(['date', 'count']) && newData.child('date').isString() && newData.child('count').isNumber() && newData.child('count').val() >= 0 && newData.child('count').val() <= 10"
        }
      }
    }
  }
}
